{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())",
        ".validate": "$code.matches(/^[A-Z]{5}$/) && newData.hasChildren(['host', 'cfg', 'createdAt'])",
        "host": { ".validate": "newData.isString()" },
        "state": { ".validate": "newData.val() === 'lobby' || newData.val() === 'play'" },
        "players": {
          "$uid": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" }
          }
        }
      }
    }
  }
}
